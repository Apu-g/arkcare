# ---------------------------------------------------------------------------
# ArkCare — frontend environment
# Copy to `.env.local` and fill in real values:  cp .env.local.example .env.local
# ---------------------------------------------------------------------------

# --- Auth (required) -------------------------------------------------------
# HMAC secret for the session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# --- Database (required) ---------------------------------------------------
# Always include the database name in the path, or the driver defaults to "test".
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/arkcare
# Atlas (SRV):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arkcare?retryWrites=true&w=majority

# --- App URL (required for socket.io + CORS) ------------------------------
# Agora microphone/camera access requires HTTPS or localhost.
# Same-machine dev: http://localhost:3000 is allowed by browsers.
# HTTPS dev: npm run dev:https  -> https://localhost:3000
# Do not use plain http://<LAN-IP>:3000 for audio/video calls.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI / LLM --------------------------------------------------------------
GROQ_API_KEY=

# --- Pusher (required — lib/pusher.js throws at import if the cluster is missing)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# --- Razorpay --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use Razorpay Test Mode keys for local/judge testing; use Live Mode keys only
# when you intentionally want real charges.
# Configure this separately in Razorpay Dashboard -> Webhooks.
# Endpoint: https://<your-app-host>/api/razorpay/webhook
# Events used by ArkCare: payment.authorized, payment.captured,
# payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Synthetic browser/E2E bypass only. Keep BOTH false for ordinary local/production use.
# When enabled, only demo.patient@arkcare.local may create a ₹0 synthetic booking
# through the explicit "Demo Book — Skip Payment" control.
CAREQUEST_TEST_BOOKING_BYPASS=false
NEXT_PUBLIC_CAREQUEST_TEST_BOOKING_BYPASS=false

# --- Cloudinary (chat image uploads) ---------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Agora (video calls) ---------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Lab report scanner (optional) ----------------------------------------
NEXT_PUBLIC_SCANNER_URL=

# --- Hackathon demo access ---------------------------------------------------
# Judge demo accounts are intentionally kept on main for the hackathon.
# Removal switch is documented in actions/demoAuthActions.js.
DEMO_LOGIN_ENABLED=true

# --- Python backend (FastAPI) ---------------------------------------------
AI_CHAT=http://127.0.0.1:8000/chat
AI_PDF=http://127.0.0.1:8000/parse_report

# Optional shared secret for locking the FastAPI service behind the Next.js proxy.
# Leave empty for local hackathon demos; set the SAME value on frontend + backend in production.
AI_INTERNAL_TOKEN=

# --- CareQuest scheduler ----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAREQUEST_JOB_SECRET=
# Optional production durable scheduling. Local/synthetic demo works without it.
QSTASH_TOKEN=

# --- CareQuest free local blockchain --------------------------------------
# Start with: scripts\start-blockchain-demo.cmd
CAREQUEST_BLOCKCHAIN_ENABLED=false
CAREQUEST_BLOCKCHAIN_BRIDGE_URL=http://127.0.0.1:8546
