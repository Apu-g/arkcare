# Root-level generated artifacts
Blockchain/node_modules/
Blockchain/runtime/
Blockchain/cache/
Blockchain/artifacts/
*.log

# Blockchain chain config — contains BRIDGEKEY_PRIVATE_KEY for the remote testnet.
# Only .env.example is tracked. See Blockchain/.env.example.
Blockchain/.env

# Local development runtime (pids, logs, local mongo data/binary)
.runtime/

# Local environment files with real credentials
Frontend/.env.local
Frontend/.env
Backend/.env

# Root-level env files — contain LIVE secrets (Pusher/Razorpay/Cloudinary keys,
# Agora certificate, Groq/Pinecone keys, MongoDB password, AUTH_SECRET, QStash
# token). Never committed. Obtain them from the repo owner (see README).
arkcare.env
backend.env
frontend.env
.env
.env.*.local


# Curl cookie jars and network captures. These were committed by accident and
# carry real session cookies, so they must never be tracked again. Scoped to
# the scratch names we actually use — a blanket *.txt would also exclude
# Backend/requirements.txt and Backend/runtime.txt.
t.txt
ta.txt
tb.txt
tc.txt
td.txt
tp.txt
cookies.txt
*.har
